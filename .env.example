# Данные компании — копия этого файла в .env.local правится без изменения кода.
# NEXT_PUBLIC_* вшиваются в бандл при сборке: после правки перезапустите
# dev-сервер или пересоберите сайт (npm run build).

# Адрес сайта (канонические URL, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://laime.kz

# Телефон = WhatsApp. Формат: +7XXXXXXXXXX (11 цифр, без пробелов)
NEXT_PUBLIC_COMPANY_PHONE=+77472271775

# Хендлы без @ и без https://
NEXT_PUBLIC_COMPANY_INSTAGRAM=laimeagency
NEXT_PUBLIC_COMPANY_TIKTOK=laimeagency
NEXT_PUBLIC_COMPANY_TELEGRAM=laime_agency

NEXT_PUBLIC_COMPANY_EMAIL=laimeagency@gmail.com
NEXT_PUBLIC_COMPANY_ADDRESS=Астана, Казахстан

# Реквизиты юрлица в футере
NEXT_PUBLIC_COMPANY_REQUISITES=ТОО «L'aime Agency» · БИН 000000000000 · Астана

# --- Аналитика (ТЗ §11.4). Счётчик подключается, только если задан его ID ---
# GA4 Measurement ID, формат G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Номер счётчика Яндекс.Метрики (только цифры), вебвизор включён
NEXT_PUBLIC_YM_ID=
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Серверные секреты (без NEXT_PUBLIC_: в бандл не попадают) ---
# Заявки с форм уходят в этот Telegram-чат (/api/lead)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
